GCP_PROJECT_ID=classisstant

# Must be the frontend's OAuth web-application client -- the frontend builds
# the consent URL from its public client ID, but this service holds the
# secret and is the only thing that exchanges the code or refreshes a token,
# so it has to authenticate as that same client both times.
# TODO(matthew): confirm with Richard this is his live client, and that the
# secret below is the actual client secret, not just the public client ID.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Must byte-match the redirect_uri Google issued the authorization code
# against, i.e. the FRONTEND's callback route (the browser lands there, not
# here -- the frontend hands this service the code server-to-server).
# Local dev: http://localhost:3000/onboarding/callback
# Cloud Run: whatever NEXT_PUBLIC_APP_URL resolves to on the frontend side,
# + /onboarding/callback -- see src/frontend/lib/googleOAuth.ts:redirectUri().
OAUTH_REDIRECT_URI=http://localhost:3000/onboarding/callback

# KMS key this service uses to both encrypt (at /auth/callback) and decrypt
# (per API request) google_refresh_token credentials (docs/adr/0004). This
# service must never be granted any rights -- encrypt or decrypt -- on the
# school_password key; that separation is enforced by IAM, not just config.
# TODO(matthew): confirm location/region with Obalua -- no default on
# purpose, Settings() fails to start without it.
KMS_LOCATION=
KMS_KEYRING=classistant-keyring
# TODO(matthew): confirm with Obalua this is the refresh-token-only key
# post credential-type split.
KMS_KEY=classistant-key
# "none" | "iv" | "user_id" -- both the encrypt and decrypt paths live in
# this service now, so this only needs to be internally consistent, not
# matched against a separate frontend implementation.
# TODO(matthew): decide with the team whether AAD is worth turning on here.
KMS_AAD_SOURCE=none
