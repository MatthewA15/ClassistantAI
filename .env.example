GCP_PROJECT_ID=classisstant

# Must be the FRONTEND's OAuth web-application client (Next.js owns login
# now) -- refresh tokens are bound to the client that issued them.
# TODO(matthew): confirm with Richard this is his live client, and that the
# secret below is the actual client secret, not just the public client ID.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# KMS key used to decrypt google_refresh_token credentials (docs/adr/0004).
# This service must never be granted decrypt rights on the school_password
# key -- that separation is enforced by IAM, not just this config.
# TODO(matthew): confirm location/region with Obalua -- no default on
# purpose, Settings() fails to start without it.
KMS_LOCATION=
KMS_KEYRING=classistant-keyring
# TODO(matthew): confirm with Obalua this is the refresh-token-only key
# post credential-type split.
KMS_KEY=classistant-key
# "none" | "iv" | "user_id" -- must match whatever AAD (if any) the frontend
# passes on the KMS encrypt call, or decrypt fails closed.
# TODO(matthew): confirm with Chim whether the frontend sets AAD.
KMS_AAD_SOURCE=none
