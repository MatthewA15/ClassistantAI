# Copy to .env.local for local development. .env.local is gitignored.
#
# Production does not read this file: those values live in apphosting.yaml, with
# secrets referenced by name out of Secret Manager.
#
# `npm run dev` reads this file and nothing else. `firebase emulators:start`
# does not: it builds the environment from apphosting.yaml and needs a matching
# apphosting.local.yaml, or it tries to read the secrets below out of Secret
# Manager and aborts on 403. See docs/design/18-emulator-env.md.
#
# Almost nothing here is a secret: the client id is shipped to every browser in
# the consent link, the URLs are public, and SESSION_SECRET is a value you
# generate for your own machine.
#
# GOOGLE_CLIENT_SECRET is the exception, and it is the one line in your
# .env.local that genuinely must not be shared or pasted anywhere. It is left
# blank here on purpose.

# HMAC key for the onboarding cookie (lib/onboardingSession.ts). It no longer
# signs the session: identity is a Firebase Auth session cookie now, so this
# only protects the short-lived state that rides across the consent redirect.
# Without it every render of /onboarding throws "SESSION_SECRET is not set".
# Generate your own, and do not use the production one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Firebase Auth in the browser (lib/firebaseClient.ts). None of this is secret:
# every Firebase web app ships these to every browser, and the API key is a
# project identifier rather than a credential. Same values as apphosting.yaml.
# Re-read them any time with:
#   firebase apps:sdkconfig WEB --project classisstant
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCA4XkNFqVLTq-GxKDppjw6WqamR4AUrKA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=classisstant.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:945345983057:web:fc8f467dc0474f2d21be70

# Where Google is told to send the student back. The consent URL is built as
# ${NEXT_PUBLIC_APP_URL}/onboarding/callback, so locally this must be your dev
# origin or the flow bounces to production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public half of the OAuth client, same value as apphosting.yaml.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=945345983057-v45ksbfcu1epohvq1cb1asfqvfp3u9ek.apps.googleusercontent.com

# The secret half. Needed once the code exchange runs on this server, because
# Google requires client authentication on that call.
#
# Get it from Secret Manager rather than from the Cloud console, so you get the
# same version production uses:
#   gcloud secrets versions access latest --secret=oauth-client-secret \
#     --project=classisstant
#
# That needs roles/secretmanager.secretAccessor on the secret; project Editor is
# NOT enough, because Editor deliberately excludes secret payloads. If it denies
# you, ask for the role rather than pasting the value through chat.
#
# Never prefix this NEXT_PUBLIC_. Next inlines NEXT_PUBLIC_* into the client
# bundle, which would publish the client secret to every visitor.
GOOGLE_CLIENT_SECRET=

# The connector performs the code exchange and holds the client secret.
#
# IMPORTANT for local sign-in: the connector exchanges the code using ITS OWN
# OAUTH_REDIRECT_URI, and Google requires that to byte-match the redirect_uri
# that started the flow. The deployed connector is pinned to the production
# callback, so a flow started from localhost gets through consent and then fails
# at the exchange. To sign in end to end from localhost, run the connector
# locally (src/backend/connectors-api) with
#   OAUTH_REDIRECT_URI=http://localhost:3000/onboarding/callback
# and point this at it, e.g. http://localhost:8080.
CONNECTORS_API_URL=https://classistant-connectors-945345983057.us-central1.run.app

# Firestore and Secret Manager go through Application Default Credentials:
#   gcloud auth application-default login
# The project id really is spelled with two s's; the product is not.
GOOGLE_CLOUD_PROJECT=classisstant
NEXT_PUBLIC_FIREBASE_PROJECT_ID=classisstant
