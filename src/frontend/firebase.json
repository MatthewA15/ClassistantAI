{
  "apphosting": {
    "backendId": "classistant",
    "rootDir": "src/frontend",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".next-verify",
      "firebase-debug.log",
      "**/*.local",
      "apphosting.local.yaml"
    ]
  },
  "emulators": {
    "apphosting": {
      "port": 5002,
      "rootDirectory": "./",
      "startCommand": "npm run dev"
    },
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
