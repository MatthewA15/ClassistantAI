# docs/... paths below are relative to the repo root, three levels above
# src/backend/connectors-api/ -- the encryption contract is shared with
# the frontend, not owned by this service.

# The refresh_token grant against Google's token endpoint requires client
# authentication for a web-application client, so this service needs the
# same OAuth client the frontend used to run the authorization_code
# exchange -- login itself lives entirely in the frontend now
# (docs/ENCRYPTION_CONTRACT.md #1), this service never sees an
# authorization code, but a refresh token is only valid against the client
# that issued it, so both sides must agree on client_id/client_secret.
# TODO(matthew): confirm with Richard this is his live client, and that the
# secret below is the actual client secret, not just the public client ID.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# KMS key this service uses to decrypt (only -- no encrypt rights) the
# google_refresh_token credential the frontend already wrote to Firestore.
# This service must never be granted any rights, encrypt or decrypt, on the
# school_password key; that separation is enforced by IAM, not just config.
# TODO(matthew): confirm location/region with Obalua -- no default on
# purpose, Settings() fails to start without it.
KMS_LOCATION=us-central1
KMS_KEYRING=classistant-keyring
# TODO(matthew): confirm with Obalua this is the refresh-token-only key
# post credential-type split.
KMS_KEY=classistant-key
# "user_id" | "none" -- docs/ENCRYPTION_CONTRACT.md #5 settles this as
# utf8_bytes(uid). Must byte-match whatever the frontend passes on its KMS
# encrypt call or decrypt fails closed with a CredentialFormatError.
KMS_AAD_SOURCE=user_id

# CALL-E, the hosted MCP server that places the actual phone call. This is
# SERVICE configuration, not a per-user credential: one bearer token for the
# whole service, like GOOGLE_CLIENT_SECRET above. It is never written to
# Firestore and never wrapped by KMS -- docs/ENCRYPTION_CONTRACT.md governs
# per-user credentials, and there is no per-user CALL-E credential.
#
# SENSITIVE: it authorizes real outbound phone calls. Don't commit it.
#
# It EXPIRES. Mint or rotate one (a browser login opens):
#     python scripts/calle_login.py
# which prints this line and the matching `gcloud run services update`. A
# 401/403 from CALL-E means "rotate this", never "the student did something
# wrong".
#
# Leave it empty to run without calling: every other endpoint is unaffected
# and the call path raises CalleNotConfigured.
CALLE_ACCESS_TOKEN=
# Defaults are correct; override only if CALL-E moves region or channel.
CALLE_BASE_URL=https://seleven-mcp-sg.airudder.com
CALLE_CHANNEL=openagent_oauth
