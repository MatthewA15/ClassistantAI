# Committed template for classy_browser/.env (which holds local dev secrets
# and is gitignored). Copy to .env and fill in real values.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=classisstant
GOOGLE_CLOUD_LOCATION=global

OBSCURA_BIN=obscura
OBSCURA_STORAGE_BASE=/mnt/cookie-storage
# Stealth mode (consistent fingerprint, TLS impersonation, tracker blocking)
OBSCURA_STEALTH=true

KMS_LOCATION=us-central1
KMS_KEYRING=classistant-keyring
KMS_KEY=classistant-password-key
KMS_AAD_SOURCE=user_id

# Set true to skip the SMS/debug-only behaviors locally.
DEBUG=false